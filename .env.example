# Copy to .env. Values shown are the defaults in packages/agri_agent_mesh/config.py.
ENVIRONMENT=local
LOG_LEVEL=INFO

# LLM provider: openai | anthropic | local
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_MODEL_URL=http://localhost:11434/v1/chat/completions

# Field messaging
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false

# Storage
DATABASE_URL=sqlite:///./agri_agent_mesh.db
REDIS_URL=redis://localhost:6379/0

# Keep true until approval workflows and fail-safes are field tested.
REQUIRE_HUMAN_APPROVAL_FOR_ACTUATION=true
